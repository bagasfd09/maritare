# Database
DATABASE_URL=postgresql://maritare:devpass@localhost:5433/maritare_dev

# Auth.js v5
AUTH_SECRET=          # generate: openssl rand -base64 32
AUTH_URL=http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Cloudflare R2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=maritare-media-dev
# Custom domain (Cloudflare zone) bound to the R2 bucket, with Image Resizing /
# Transformations enabled. When set, PUBLISHED invitation photos are served as
# public, CDN-cached, auto-resized URLs (/cdn-cgi/image/...). Empty = fall back to
# presigned URLs (dev). e.g. https://media.maritare.id
# PRODUCTION: set this so the WhatsApp/social share image (og:image) resolves to a
# stable, non-expiring CDN URL. Without it, og:image uses a 1h presigned URL that
# can 403 when a platform re-fetches a cached link card past the hour.
R2_PUBLIC_URL=

# Midtrans
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_IS_PRODUCTION=false

# Fonnte (WhatsApp)
FONNTE_TOKEN=

# Resend
RESEND_API_KEY=
RESEND_FROM_EMAIL=hello@maritare.id

# Redis (lokal via docker)
REDIS_URL=redis://localhost:6379

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
