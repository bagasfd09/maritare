# Database
DATABASE_URL=postgresql://maritare:devpass@localhost:5433/maritare_dev

# Auth.js v5
AUTH_SECRET=          # generate: openssl rand -base64 32
AUTH_URL=http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Cloudflare R2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=maritare-media-dev
# Custom domain (Cloudflare zone) bound to the R2 bucket, with Image Resizing /
# Transformations enabled. When set, PUBLISHED invitation photos are served as
# public, CDN-cached, auto-resized URLs (/cdn-cgi/image/...). Empty = fall back to
# presigned URLs (dev). e.g. https://media.maritare.id
# PRODUCTION: set this so the WhatsApp/social share image (og:image) resolves to a
# stable, non-expiring CDN URL. Without it, og:image uses a 1h presigned URL that
# can 403 when a platform re-fetches a cached link card past the hour.
R2_PUBLIC_URL=

# ── DOKU (payment gateway) ───────────────────────────────────────
# SERVER-SIDE ONLY — never expose the secret key or private key to the client.
# All values come from DOKU Back Office → Integration.
#
# TWO auth stacks are in use, because DOKU splits them:
#   · non-SNAP (HMAC-SHA256) — Virtual Account v2 + hosted Checkout page.
#     THE LIVE VA PATH: needs only client id + secret key, no per-bank config.
#   · SNAP     (RSA + HMAC-SHA512) — QRIS, plus a dormant SNAP-VA path (this
#     account isn't provisioned for SNAP VA — every create-va answers 4032715).
# Verify both wirings offline: pnpm check:doku && pnpm check:doku:snap
DOKU_CLIENT_ID=
DOKU_SECRET_KEY=
DOKU_IS_PRODUCTION=false

# SNAP only. The RSA private key whose PUBLIC half is registered in DOKU Back
# Office — it signs the B2B token request. Paste the PEM with literal \n escapes
# on one line, e.g. "-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----"
DOKU_PRIVATE_KEY=
# X-PARTNER-ID. Usually the same as DOKU_CLIENT_ID; set only if DOKU issued a
# different partner id.
DOKU_PARTNER_ID=

# SNAP VA only (dormant path — VA currently issues via non-SNAP v2, which needs
# no per-bank config). Format "<Partner Service ID>:<Prefix Customer No>" from
# Back Office → Payment Configuration → Virtual Account, e.g. "19008:9".
DOKU_VA_PARTNER_SERVICE_ID=
# DOKU_VA_PARTNER_SERVICE_IDS={"VIRTUAL_ACCOUNT_BCA":"19008:9","VIRTUAL_ACCOUNT_BANK_MANDIRI":"88910:8"}

# QRIS merchant + terminal, from Back Office. Terminal id is 3–16 alphanumerics.
# Leave blank until DOKU activates QRIS — checkout then offers VA only.
DOKU_QRIS_MERCHANT_ID=
DOKU_QRIS_TERMINAL_ID=

# Notification URLs to register in DOKU Back Office. The path is part of the
# SIGNED payload, so it must match character-for-character (no trailing slash).
# Locally, point them at a tunnel (cloudflared/ngrok) — DOKU can't reach localhost.
#   Checkout + VA v2 (non-SNAP): <NEXT_PUBLIC_APP_URL>/api/webhook/doku
#   SNAP QRIS payment:           <NEXT_PUBLIC_APP_URL>/v1.0/qr/qr-mpm-notify
#   SNAP VA payment (dormant):   <NEXT_PUBLIC_APP_URL>/v1.1/transfer-va/payment
# Set this ONLY if a proxy rewrites the path before it reaches the app, so
# signature verification still uses the path DOKU actually signed.
# DOKU_SNAP_NOTIFICATION_PATH=/v1.1/transfer-va/payment

# Fonnte (WhatsApp)
FONNTE_TOKEN=

# Resend
RESEND_API_KEY=
RESEND_FROM_EMAIL=hello@maritare.id

# Redis (lokal via docker)
REDIS_URL=redis://localhost:6379

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
